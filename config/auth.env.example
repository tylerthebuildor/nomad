# Nomad sign-in settings for `auth` (bin/auth).
#
# Copy to config/auth.env (gitignored) and fill in your accounts; `make bootstrap`
# installs it to ~/.config/nomad/auth.env on the box. Or edit that file on the
# box directly. Blank values are fine: they only skip a step on the sign-in page.

# Services `auth` shows, in this order. Leave empty to show every auth/*.sh.
AUTH_SERVICES="gcloud aws gh vercel claude"

# Port for the short sign-in link (http://<box>:<port>, tailnet only).
AUTH_SHORTLINK_PORT=8085

# Google Cloud: preselects this account on Google's sign-in page.
AUTH_GCLOUD_ACCOUNT=""

# AWS: how you sign in to the CLI.
#   keys   long-lived access keys from `aws configure`; nothing to sign in to
#   login  console sign-in (root or IAM user) via `aws login`; lasts up to 12h
#   sso    IAM Identity Center via `aws sso login`
AUTH_AWS_MODE="keys"
AUTH_AWS_PROFILE="default"
AUTH_AWS_REGION="us-east-1"

# GitHub: the account you expect; auth warns if you are signed in as another.
AUTH_GH_USER=""

# Vercel: the account you expect; auth warns if you are signed in as another.
AUTH_VERCEL_USER=""

# Claude Code: prefilled on the sign-in page.
AUTH_CLAUDE_EMAIL=""
