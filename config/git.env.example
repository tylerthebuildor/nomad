# Nomad git identity, set on the box by `make up` / `make bootstrap`.
#
# Copy to config/git.env (gitignored), or let `make up` fill it in from this
# computer's git config. Without it, commits on the box are authored as
# ubuntu@<host>: GitHub won't attribute them to you, and Vercel's GitHub
# integration rejects the deploy ("not a member of the team").

# Your name on commits.
GIT_USER_NAME=""

# The email tied to your GitHub (and Vercel) account.
GIT_USER_EMAIL=""
