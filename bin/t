#!/usr/bin/env bash
# t , pick a running tmux session or start a new one (phone-friendly).
#
# Runs on login so each Termux tab can open a different session instead of every
# tab joining the same one. Lists every running session, whatever it is doing,
# with what is running in it (e.g. claude), where, and when it was last used.
# Sessions are not tied to a project; cd wherever you like once inside.
#
# Usage:
#   t             menu (enter: open, ctrl-x: kill, ctrl-r: rename, esc: plain shell)
#   t <name>      open the session with that name, or start it if there is none
#   inside tmux:  prefix + S opens the same menu in a popup to switch
#
# New sessions start in NOMAD_START_DIR (default: ~/dev, else ~) and run
# NOMAD_NEW_CMD (default: claw, i.e. Claude Code); set it empty for a plain shell.
set -uo pipefail

SELF="$(readlink -f "$0")"
START="${NOMAD_START_DIR:-$HOME/dev}"
[ -d "$START" ] || START="$HOME"
NEW_CMD="${NOMAD_NEW_CMD-claw}"

# Shared palette, fit() and the nomad header (lib/ui.sh). t runs on every login,
# so if that is missing it falls back to plain text instead of failing.
for share in "${NOMAD_SHARE:-}" "$HOME/.local/share/nomad" "$(dirname "$SELF")/.."; do
  [ -n "$share" ] && [ -f "$share/lib/ui.sh" ] && { . "$share/lib/ui.sh"; break; }
done
if ! declare -F nomad_header >/dev/null; then
  R="" B="" DIM="" FAINT="" ACC="" LIVE="" IDLE="" DIR="" NAME=""
  FZF_COLORS='fg:252'
  cols() { local c; c="$(stty size 2>/dev/null </dev/tty | cut -d' ' -f2)"; echo "${c:-80}"; }
  fit() { local s="$1" n="$2"; [ "${#s}" -gt "$n" ] && s="${s:0:n-1}…"; printf '%-*s' "$n" "$s"; }
  nomad_header() { printf 'nomad\n%s\n%s\n' "${1:-}" "${2:-}"; }
fi

ago() {
  local s=$(( $(date +%s) - $1 ))
  if   [ "$s" -lt 60 ];    then echo "now"
  elif [ "$s" -lt 3600 ];  then echo "$((s / 60))m"
  elif [ "$s" -lt 86400 ]; then echo "$((s / 3600))h"
  else echo "$((s / 86400))d"; fi
}

# One line per entry: session name <tab> what fzf shows. Most recently used
# first. Sized for a phone (~50 columns); wider terminals also get full paths.
list() {
  local width; width="$(cols)"
  local new="${ACC}${B}+ new session${R}"
  [ -n "$NEW_CMD" ] && new+="  ${FAINT}${NEW_CMD} in ${START/#$HOME/\~}${R}"
  printf '\t%s\n' "$new"
  tmux has-session 2>/dev/null || return 0

  local rows=() nw=4 line
  while IFS= read -r line; do
    rows+=("$line"); local n="${line#*$'\t'}"; n="${n%%$'\t'*}"
    [ "${#n}" -gt "$nw" ] && nw="${#n}"
  done < <(tmux list-sessions -F '#{session_activity}	#{session_name}	#{session_attached}	#{session_windows}	#{pane_current_command}	#{pane_current_path}' | sort -rn)
  [ "$nw" -gt 14 ] && nw=14

  local activity name attached windows cmd path dot what where
  for line in "${rows[@]}"; do
    IFS=$'\t' read -r activity name attached windows cmd path <<<"$line"
    if [ "$attached" -gt 0 ]; then dot="${LIVE}●"; else dot="${IDLE}○"; fi
    case "$cmd" in
      claude) what="${ACC}$(fit claude 6)" ;;
      bash|zsh|fish|sh) what="${FAINT}$(fit shell 6)" ;;
      *) what="${DIM}$(fit "$cmd" 6)" ;;
    esac
    if [ "$path" = "$HOME" ]; then where="~"; else where="${path##*/}"; fi
    if [ "$width" -ge 80 ]; then
      where="${path/#$HOME/\~}"
      [ "$windows" -gt 1 ] && where+="  ${FAINT}${windows} windows"
    fi
    printf '%s\t%s %s%s%s  %s  %s%3s%s  %s%s%s\n' "$name" "$dot" "$NAME" "$(fit "$name" "$nw")" "$R" \
      "$what" "$DIM" "$(ago "$activity")" "$R" "$DIR" "$where" "$R"
  done
}

header() {
  local count=0 now
  tmux has-session 2>/dev/null && count="$(tmux list-sessions 2>/dev/null | wc -l)"
  now="$(date +%H:%M)"
  local sep="  " # key help fits one line from ~42 columns; wrap it below that
  [ "$(cols)" -lt 42 ] && sep=$'\n'
  nomad_header "$(hostname -s) · ${now}" "${count} session$([ "$count" = 1 ] || echo s)"
  printf '%s\n' \
    "" \
    "${ACC}⏎${R} ${DIM}open${R}  ${ACC}^x${R} ${DIM}kill${R}$sep${ACC}^r${R} ${DIM}rename${R}  ${ACC}esc${R} ${DIM}shell${R}" \
    "${LIVE}●${R} ${FAINT}open in a tab${R}  ${IDLE}○${R} ${FAINT}waiting${R}"
}

# First free name: 1, 2, 3, ...
next_name() { local i=1; while tmux has-session -t "=$i" 2>/dev/null; do i=$((i + 1)); done; echo "$i"; }

open() {
  local name="${1//[.:]/_}" # tmux session names cannot contain . or :
  if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmux new-session -d -s "$name" -c "$START"
    # Typed into the session's shell (not run as its command), so quitting it
    # leaves you at a prompt instead of closing the session.
    [ -n "$NEW_CMD" ] && tmux send-keys -t "=$name:" "$NEW_CMD" Enter
  fi
  if [ -n "${TMUX:-}" ]; then tmux switch-client -t "=$name"; else tmux attach -t "=$name"; fi
}

case "${1:-}" in
  --list) list; exit 0 ;;
  -h|--help) sed -n '2,15p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "") ;;
  *) open "$1"; exit ;;
esac

command -v fzf >/dev/null 2>&1 || { echo "t: fzf is not installed" >&2; exit 1; }

sel="$(list | fzf --ansi --delimiter='\t' --with-nth=2 --no-sort --reverse --height=100% \
  --header="$(header)" --header-first --info=hidden --no-scrollbar \
  --prompt='  › ' --pointer='▌' --ellipsis='…' --margin=1,0,0,0 \
  --color="$FZF_COLORS" \
  --bind "ctrl-x:execute-silent([ -n {1} ] && tmux kill-session -t ={1})+reload('$SELF' --list)" \
  --bind "ctrl-r:execute([ -n {1} ] && printf '\n  \033[38;5;208m›\033[0m rename {1} to: ' && read -r n </dev/tty && [ -n \"\$n\" ] && tmux rename-session -t ={1} \"\${n//[.:]/_}\")+reload('$SELF' --list)")" || exit 0

name="${sel%%$'\t'*}"
if [ -z "$name" ]; then
  printf '\n  %s›%s name for the new session %s(enter for %s)%s: ' "$ACC" "$R" "$DIM" "$(next_name)" "$R"
  read -r name </dev/tty
  name="${name:-$(next_name)}"
fi
open "$name"
